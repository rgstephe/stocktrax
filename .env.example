# Copy to .env and adjust. These are read on first run to seed settings;
# after that, most are editable in the Admin → Settings screen.

PORT=3000
COMPANY_NAME=Ultra Pest Control

# Starter admin PIN for the console login (change immediately).
ADMIN_PIN=4242

# Barcode lookup: "upcitemdb" (general retail) or "openfoodfacts" (food).
BARCODE_PROVIDER=upcitemdb
BARCODE_API_KEY=

# Where the SQLite database file is stored.
DATA_DIR=./data
